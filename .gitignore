# ---------------------------------------------------------------
# Datasets (large, re-downloadable)
# ---------------------------------------------------------------
# PARA/medmnist/ holds MedMNIST .npz files (~3.5 GB); fetch with the
# `medmnist` package instead of committing.
PARA/medmnist/
**/medmnist/
*.npz
*.npy
data/
datasets/

# ---------------------------------------------------------------
# Model weights, tensor caches, checkpoints (regenerable)
# ---------------------------------------------------------------
# e.g. PARA/para_results/<dataset>/zS_cache.pt — cached CLIP features
*.pt
*.pth
*.ckpt
*.safetensors
*.bin
*.onnx
*_cache.*
checkpoints/
wandb/
runs/
lightning_logs/

# Small result artifacts (csv/txt/json/png) under para_results/ ARE kept.

# ---------------------------------------------------------------
# Python / Jupyter
# ---------------------------------------------------------------
__pycache__/
*.py[cod]
.ipynb_checkpoints/
*.egg-info/
.venv/
venv/
env/
.env

# ---------------------------------------------------------------
# OS / editor junk
# ---------------------------------------------------------------
.DS_Store
._*
Thumbs.db
desktop.ini
*:Zone.Identifier
.vscode/
.idea/
*.swp

# Dual_kernel local data and caches
Dual_kernel/Dataset_*/
# keep small results (csv/png/json/captions); drop logs and superseded caption files
Dual_kernel/mm_pipeline_*/*.log
Dual_kernel/mm_pipeline_busi/captions_334084db.jsonl
Dual_kernel/mm_pipeline_busi/captions_ef30351b.jsonl
Dual_kernel/mm_pipeline_busi/captions_8aff7799.jsonl
# Dual_kernel scratch and the old prototype
Dual_kernel/cell6.py
Dual_kernel/dualkernel_biovlm.ipynb

# local inference tools and model files (llama.cpp, GGUF)
tools/
Dual_kernel/mm_pipeline_*/*partial*
# DKA notebook caches (text embeddings); keep its CSV results
Dual_kernel/mm_dka/*.pt
# BioVLM attribute JSONs (upstream repo has no licence; fetched locally for reference only)
Dual_kernel/biovlm_attributes/
# MedSigLIP notebook caches (image/text embeddings)
Dual_kernel/mm_medsiglip/*.pt
